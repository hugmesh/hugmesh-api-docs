{
  "name": "@hugmesh/api-docs",
  "version": "0.1.0",
  "description": "Admin-gated federated remote: browse the platform OpenAPI specs (admin/mod/user BFFs, federation-api, actions). Angular micro-frontend (native-federation remote) for the hugmesh.net host. Reuses the hugmesh.games api-docs ecosystem.",
  "license": "MIT",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve api-docs",
    "build": "ng build api-docs",
    "build:api-docs": "ng build api-docs",
    "test": "ng test api-docs --watch=false --browsers=ChromeHeadlessCI",
    "test:watch": "ng test api-docs",
    "check:ci-wiring": "bash scripts/check-ci-wiring.sh",
    "test:ci-wiring": "bash scripts/check-ci-wiring.test.sh",
    "gen": "ng-openapi-gen --config ng-openapi-gen.json",
    "gen:fetch:admin": "curl -sf http://localhost:8080/v3/api-docs -o src/assets/specs/openapi-admin.json",
    "gen:fetch:mod": "curl -sf http://localhost:8080/v3/api-docs -o src/assets/specs/openapi-mod.json",
    "gen:fetch:user": "curl -sf http://localhost:8080/v3/api-docs -o src/assets/specs/openapi-user.json",
    "gen:fetch:federation": "curl -sf http://localhost:8080/v3/api-docs -o src/assets/specs/openapi-federation.json",
    "gen:fetch:actions": "curl -sf http://localhost:8090/v3/api-docs -o src/assets/specs/openapi-actions.json",
    "gen:fetch:wiki": "curl -sf http://localhost:8080/v3/api-docs -o src/assets/specs/openapi-wiki.json",
    "prebuild": "test -s openapi.json && npm run gen || true"
  },
  "dependencies": {
    "@angular-architects/native-federation": "^22.0.0",
    "@angular/animations": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-browser-dynamic": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@softarc/native-federation-node": "^3.5.5",
    "es-module-shims": "^2.8.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.6.0",
    "zone.js": "^0.16.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@types/jasmine": "^5.1.15",
    "jasmine-core": "^5.13.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "ng-openapi-gen": "^1.0.5",
    "ng-packagr": "^22.0.0",
    "typescript": "~6.0.3"
  }
}
